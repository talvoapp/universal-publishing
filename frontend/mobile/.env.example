# ============================================================
# Mobile App — Environment Variables
# ============================================================
# Note: Expo reads these at build time. For runtime config,
# use app.json `extra` (loaded via expo-constants).

# API Gateway
EXPO_PUBLIC_API_URL=http://localhost:8080

# WebSocket (editor)
EXPO_PUBLIC_WS_URL=ws://localhost:8080/editor/stream

# Environment
EXPO_PUBLIC_APP_ENV=development