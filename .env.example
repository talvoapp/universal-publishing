# =============================================================================
# Universal Publishing Platform — Environment Variables (UNIFIED)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# NEVER commit `.env`. Only `.env.example` is versioned.
#
# Conventions:
#   • SERVICE_*    — per-service overrides
#   • *_URL        — full connection URL
#   • *_HOST/PORT  — discrete connection parts
#   • *_SECRET     — sensitive; rotate regularly
#   • FEATURE_*    — boolean toggles (true / false)
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
# Shared connection settings for the five logical databases:
#   • auth_db         — users, refresh tokens, audit logs
#   • marketplace_db  — items, orders, subscriptions, outbox
#   • wallet_db       — ledger transactions, entries, payouts
#   • feed_db         — follows, users_follow_counts, posts_metadata
#   • notifications_db — in-app notifications, processed_events
POSTGRES_USER=upp
POSTGRES_PASSWORD=upp_dev_password
POSTGRES_DB=upp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full URLs used by each service at runtime
DATABASE_URL_AUTH=postgres://upp:upp_dev_password@postgres:5432/auth_db?sslmode=disable
DATABASE_URL_MARKETPLACE=postgres://upp:upp_dev_password@postgres:5432/marketplace_db?sslmode=disable
DATABASE_URL_WALLET=postgres://upp:upp_dev_password@postgres:5432/wallet_db?sslmode=disable
DATABASE_URL_FEED=postgres://upp:upp_dev_password@postgres:5432/feed_db?sslmode=disable
DATABASE_URL_NOTIFICATIONS=postgres://upp:upp_dev_password@postgres:5432/notifications_db?sslmode=disable

# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------
# Stores drafts, draft ops, articles, books, chapters, taxonomy.
MONGO_USER=upp
MONGO_PASSWORD=upp_mongo_password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_URL=mongodb://upp:upp_mongo_password@mongodb:27017/upp_editor?authSource=admin

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Logical database allocation — do not reorder without updating code:
#   DB 0 — auth sessions & refresh tokens
#   DB 1 — editor presence & patch buffers
#   DB 2 — AI quotas & SSE resume sessions
#   DB 3 — marketplace cache & idempotency keys
#   DB 4 — entitlement cache (READ-HOT)
#   DB 5 — feed timelines (Sorted Sets)
#   DB 6 — notification dedup + wallet idempotency
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# KAFKA
# -----------------------------------------------------------------------------
# Transactional outbox event stream. Topic names are lowercase, dot-separated.
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=upp-consumers
KAFKA_TOPIC_OUTBOX=upp.outbox.events

# -----------------------------------------------------------------------------
# RABBITMQ
# -----------------------------------------------------------------------------
# Used exclusively by formatting-service for render jobs.
RABBITMQ_USER=upp
RABBITMQ_PASSWORD=upp_rabbit_password
RABBITMQ_URL=amqp://upp:upp_rabbit_password@rabbitmq:5672/
RABBITMQ_QUEUE_FORMATTING=formatting.jobs

# -----------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# -----------------------------------------------------------------------------
# Both secrets MUST be unique, cryptographically random, and at least 32 chars.
# Generate with: openssl rand -base64 48
JWT_SECRET=dev_jwt_secret_change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_min_32_chars
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/oauth/github/callback

# -----------------------------------------------------------------------------
# STRIPE (payments, subscriptions, tax, payouts)
# -----------------------------------------------------------------------------
# Get keys from https://dashboard.stripe.com/apikeys
# In local dev, use the Stripe CLI to forward webhooks:
#   stripe listen --forward-to localhost:8080/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_FEE_PERCENT=15

# -----------------------------------------------------------------------------
# AI PROVIDERS
# -----------------------------------------------------------------------------
# Primary and fallback LLM providers for the Smart Editor's AI assistant.
# Quotas are enforced per user per day via Redis token buckets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
AI_ENABLE_FALLBACK=true
AI_FREE_TIER_DAILY_TOKENS=5000
AI_PREMIUM_TIER_DAILY_TOKENS=100000
AI_ADMIN_TIER_DAILY_TOKENS=1000000
AI_QUOTA_WINDOW_HOURS=24

# -----------------------------------------------------------------------------
# OBJECT STORAGE (S3 / MinIO)
# -----------------------------------------------------------------------------
# In production: use AWS S3 with IAM role; leave keys empty.
# In local dev:  MinIO is provided by docker-compose.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=upp_minio
S3_SECRET_KEY=upp_minio_password
S3_BUCKET=upp-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MINIO_USER=upp_minio
MINIO_PASSWORD=upp_minio_password

# -----------------------------------------------------------------------------
# EMAIL / SMTP
# -----------------------------------------------------------------------------
# In local dev, MailHog captures all outbound email at http://localhost:8025.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@upp.local
SMTP_FROM_NAME=Universal Publishing
EMAIL_RATE_LIMIT_PER_HOUR=100

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# OpenTelemetry exports traces to Jaeger (OTLP/HTTP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=upp
OTEL_TRACES_SAMPLER=parentbased_always_on
SENTRY_DSN=
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
# These are consumed by Vite (dashboard) and Next.js (public site).
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/editor/stream
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SECURITY / RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSP_REPORT_URI=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_AI_ENABLED=true
FEATURE_PAY_PER_CHAPTER=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_HYBRID_FEED=true
FEATURE_DMCA_WORKFLOW=true

# -----------------------------------------------------------------------------
# DMCA / LEGAL
# -----------------------------------------------------------------------------
DMCA_AGENT_EMAIL=dmca@upp.local
DMCA_REVIEW_SLA_HOURS=24
PRIVACY_POLICY_URL=https://upp.local/privacy
TERMS_OF_SERVICE_URL=https://upp.local/terms