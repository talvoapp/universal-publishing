# ============================================================
# Feed Service — Environment Variables
# ============================================================

# Runtime
NODE_ENV=development
PORT=4007
LOG_LEVEL=debug
TZ=UTC

# PostgreSQL (follow graph + counters + posts metadata)
DATABASE_URL=postgres://upp:upp_dev_password@postgres:5432/feed_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT=30s

# Redis (DB 5 — timelines)
REDIS_URL=redis://redis:6379/5
REDIS_KEY_PREFIX=feed:

# Kafka (DraftPublished events from editor-service)
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_OUTBOX=upp.outbox.events
KAFKA_CONSUMER_GROUP=feed-service
KAFKA_CLIENT_ID=feed-service

# JWT (must match auth-service)
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=120

# Hybrid fan-out strategy
# Users with <= CELEBRITY_THRESHOLD followers use PUSH fan-out.
# Users with > CELEBRITY_THRESHOLD followers use PULL fan-out.
CELEBRITY_THRESHOLD=1000

# Timeline caps
TIMELINE_MAX_SIZE=1000
TIMELINE_FANOUT_CAP=10000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SERVICE_NAME=feed-service
SERVICE_VERSION=1.0.0