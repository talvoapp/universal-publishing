# ============================================================
# AI Service — Environment Variables
# Copy to .env; inject via orchestrator in production.
# ============================================================

# ------------------------------------------------------------
# RUNTIME
# ------------------------------------------------------------
NODE_ENV=development
PORT=4003
LOG_LEVEL=debug
TZ=UTC

# ------------------------------------------------------------
# REDIS (DB 2 — ai-service)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/2
REDIS_KEY_PREFIX=ai:

# ------------------------------------------------------------
# JWT (must match auth-service)
# ------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------
# HTTP RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# PROVIDERS
# ------------------------------------------------------------
# At least one of OPENAI_API_KEY or ANTHROPIC_API_KEY is REQUIRED.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_MS=60000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_TIMEOUT_MS=60000

AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
AI_ENABLE_FALLBACK=true

# ------------------------------------------------------------
# TIER QUOTAS (daily token budgets)
# ------------------------------------------------------------
AI_FREE_TIER_DAILY_TOKENS=5000
AI_PREMIUM_TIER_DAILY_TOKENS=100000
AI_ADMIN_TIER_DAILY_TOKENS=1000000
AI_QUOTA_WINDOW_HOURS=24
AI_QUOTA_WARNING_THRESHOLD=80

# ------------------------------------------------------------
# SSE / SESSION
# ------------------------------------------------------------
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_SESSION_TTL_SECONDS=600
SSE_MAX_STREAM_DURATION_MS=180000
SSE_MAX_OUTPUT_CHARS=50000

# ------------------------------------------------------------
# RETRY
# ------------------------------------------------------------
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500

# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SENTRY_DSN=
SERVICE_NAME=ai-service
SERVICE_VERSION=1.0.0