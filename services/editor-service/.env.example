# ============================================================
# Editor Service — Environment Variables
# ============================================================

# ------------------------------------------------------------
# RUNTIME
# ------------------------------------------------------------
NODE_ENV=development
PORT=4002
LOG_LEVEL=debug
TZ=UTC

# ------------------------------------------------------------
# MONGODB
# ------------------------------------------------------------
MONGO_URL=mongodb://upp:upp_mongo_password@mongodb:27017/upp_editor?authSource=admin
MONGO_DB_NAME=upp_editor
MONGO_MAX_POOL=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------
# REDIS (DB 1 — editor)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=editor:

# ------------------------------------------------------------
# JWT (must match auth-service)
# ------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# ------------------------------------------------------------
# KAFKA
# ------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_OUTBOX=upp.outbox.events
KAFKA_CLIENT_ID=editor-service

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------
# HTTP RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# WEBSOCKET TUNING
# ------------------------------------------------------------
WS_PATH=/editor/stream
WS_MAX_PAYLOAD_BYTES=524288              # 512 KB
WS_PING_INTERVAL_MS=30000                # 30 s
WS_PONG_TIMEOUT_MS=10000                 # 10 s
WS_MAX_CONNECTIONS_PER_USER=10
WS_MAX_MESSAGE_RATE_PER_SEC=60

# ------------------------------------------------------------
# EDITOR SEMANTICS
# ------------------------------------------------------------
EDITOR_PATCH_COALESCE_MS=200             # server-side debounce
EDITOR_SNAPSHOT_EVERY_N_OPS=50
EDITOR_PRESENCE_TTL_MS=60000             # 60 s
EDITOR_MAX_DRAFT_CHARS=5000000           # 5 MB

# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SENTRY_DSN=
SERVICE_NAME=editor-service
SERVICE_VERSION=1.0.0