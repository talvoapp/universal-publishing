# ============================================================
# Editor Service — Docker build context exclusions
# ============================================================

# --- Dependencies ---
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build output ---
dist
coverage
*.tsbuildinfo

# --- Tests ---
tests
**/*.test.ts
**/*.spec.ts
jest.config.js
.nyc_output

# --- Dev & env files (NEVER ship into an image) ---
.env
.env.*
!.env.example
.env.local
.env.development
.env.production

# --- IDE & OS ---
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# --- VCS ---
.git
.gitignore
.gitattributes
.github

# --- Docs ---
README.md
CHANGELOG.md
LICENSE
docs

# --- Docker files ---
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml