<div style="background: #fee2e2; padding: 16px; border-radius: 8px; margin: 16px 0;">
  <p style="margin: 4px 0;"><strong>Content ID:</strong> {{contentId}}</p>
  <p style="margin: 4px 0;"><strong>Title:</strong> {{contentTitle}}</p>
