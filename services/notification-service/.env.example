# ============================================================
# Notification Service — Environment Variables
# ============================================================

# Runtime
NODE_ENV=development
PORT=4008
LOG_LEVEL=debug
TZ=UTC

# PostgreSQL (notifications inbox + processed_events)
DATABASE_URL=postgres://upp:upp_dev_password@postgres:5432/notifications_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (DB 6 — dedup + rate limits)
REDIS_URL=redis://redis:6379/6
REDIS_KEY_PREFIX=notify:

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_OUTBOX=upp.outbox.events
KAFKA_CONSUMER_GROUP=notification-service
KAFKA_CLIENT_ID=notification-service

# SMTP (Mailhog in dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@upp.local
SMTP_FROM_NAME=Universal Publishing

# Email behavior
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_MS=1000
EMAIL_RATE_LIMIT_PER_HOUR=100

# In-app notifications
IN_APP_RETENTION_DAYS=90

# Frontend (used for CTA links in emails)
FRONTEND_URL=http://localhost:3000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SENTRY_DSN=
SERVICE_NAME=notification-service
SERVICE_VERSION=1.0.0