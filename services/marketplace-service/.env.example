# ============================================================
# Marketplace Service — Environment Variables
# ============================================================

# Runtime
NODE_ENV=development
PORT=4004
LOG_LEVEL=debug
TZ=UTC

# PostgreSQL
DATABASE_URL=postgres://upp:upp_dev_password@postgres:5432/marketplace_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT=30s

# Redis (DB 3 — marketplace)
REDIS_URL=redis://redis:6379/3
REDIS_KEY_PREFIX=market:

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_OUTBOX=upp.outbox.events
KAFKA_CLIENT_ID=marketplace-service

# JWT (must match auth-service)
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=100

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_FEE_PERCENT=15

# Checkout
CHECKOUT_SESSION_EXPIRY=1h

# Idempotency
IDEMPOTENCY_TTL=24h

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SERVICE_NAME=marketplace-service
SERVICE_VERSION=1.0.0