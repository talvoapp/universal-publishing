# ============================================================
# Content Service — Environment Variables
# ============================================================

# Runtime
NODE_ENV=development
PORT=4006
LOG_LEVEL=debug
TZ=UTC

# PostgreSQL (marketplace_db — entitlements live here)
DATABASE_URL=postgres://upp:upp_dev_password@postgres:5432/marketplace_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT=30s

# MongoDB (upp_editor — content lives here)
MONGO_URL=mongodb://upp:upp_mongo_password@mongodb:27017/upp_editor?authSource=admin
MONGO_DB_NAME=upp_editor
MONGO_MAX_POOL=20
MONGO_SERVER_SELECTION_TIMEOUT=5s

# Redis (DB 4 — entitlement cache)
REDIS_URL=redis://redis:6379/4
REDIS_KEY_PREFIX=content:

# JWT (must match auth-service)
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=100

# Entitlement cache
ENTITLEMENT_CACHE_TTL=5m

# Preview behavior (0.0 - 1.0)
PREVIEW_FRACTION=0.15

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SERVICE_NAME=content-service
SERVICE_VERSION=1.0.0