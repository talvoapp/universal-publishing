# ============================================================
# Wallet Service — Environment Variables
# ============================================================

# Runtime
NODE_ENV=development
PORT=4005
LOG_LEVEL=debug
TZ=UTC

# PostgreSQL
DATABASE_URL=postgres://upp:upp_dev_password@postgres:5432/wallet_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT=30s

# Redis (DB 6 — wallet)
REDIS_URL=redis://redis:6379/6
REDIS_KEY_PREFIX=wallet:

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_OUTBOX=upp.outbox.events
KAFKA_CONSUMER_GROUP=wallet-service
KAFKA_CLIENT_ID=wallet-service

# JWT (must match auth-service)
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=100

# Stripe (Connect)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me

# Payout policy
PAYOUT_MINIMUM_CENTS=1000
PAYOUT_DELAY_DAYS=7
PAYOUT_MAXIMUM_CENTS=1000000

# Platform economics
STRIPE_PLATFORM_FEE_PERCENT=15

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SERVICE_NAME=wallet-service
SERVICE_VERSION=1.0.0