# ============================================================
# Auth Service — Environment Variables
# Copy to `.env` and fill in real values.
# In production, inject these via your orchestrator (K8s Secrets / ECS).
# ============================================================

# ------------------------------------------------------------
# RUNTIME
# ------------------------------------------------------------
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
TZ=UTC

# ------------------------------------------------------------
# POSTGRESQL
# ------------------------------------------------------------
# Must be a postgres:// URL. The service validates it at startup.
DATABASE_URL=postgres://upp:upp_dev_password@postgres:5432/auth_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------
# DB index 0 is reserved for auth sessions & rate-limit counters.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=auth:

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
# Each secret MUST be ≥ 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_long!!
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=upp-auth
JWT_AUDIENCE=upp-platform

# ------------------------------------------------------------
# PASSWORD HASHING
# ------------------------------------------------------------
# 12 is the recommended default (≈250ms per hash).
# Range allowed by config validation: 10–15.
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# OAUTH (optional — leave blank to disable a provider)
# ------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/oauth/google/callback

# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/oauth/github/callback

# ------------------------------------------------------------
# EMAIL (SMTP)
# ------------------------------------------------------------
# Local dev uses MailHog: http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@upp.local

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated. The service parses this into an allowlist at startup.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------
# OpenTelemetry collector endpoint (Jaeger all-in-one exposes :4318 for OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Sentry is optional — leave blank in dev to disable
SENTRY_DSN=
SERVICE_NAME=auth-service
SERVICE_VERSION=1.0.0

# ------------------------------------------------------------
# FRONTEND (used for OAuth redirects + email links)
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:3000