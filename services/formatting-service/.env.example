# ============================================================
# Formatting Service — Environment Variables
# ============================================================

# ------------------------------------------------------------
# RUNTIME
# ------------------------------------------------------------
NODE_ENV=development          # reuse the same var name for consistency
PORT=4008
LOG_LEVEL=info
TZ=UTC

# ------------------------------------------------------------
# RABBITMQ
# ------------------------------------------------------------
RABBITMQ_URL=amqp://upp:upp_rabbit_password@rabbitmq:5672/
RABBITMQ_QUEUE=formatting.jobs
RABBITMQ_EXCHANGE=formatting
RABBITMQ_ROUTING_KEY=formatting.job
RABBITMQ_PREFETCH=2
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=15

# ------------------------------------------------------------
# S3 / MINIO
# ------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=upp_minio
S3_SECRET_KEY=upp_minio_password
S3_BUCKET=upp-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------
# PANDOC / CONVERSION
# ------------------------------------------------------------
PANDOC_BINARY=pandoc
CONVERSION_TIMEOUT_SECONDS=120
MAX_INPUT_SIZE_BYTES=10485760   # 10 MB

# ------------------------------------------------------------
# PDF / WEASYPRINT
# ------------------------------------------------------------
WEASYPRINT_BASE_URL=
PDF_PAGE_SIZE=A5
PDF_MARGIN_MM=20

# ------------------------------------------------------------
# COVER GENERATION (DALL-E — optional)
# ------------------------------------------------------------
# Leave empty to use local Pillow-generated placeholders instead.
OPENAI_API_KEY=
DALLE_MODEL=dall-e-3
COVER_THUMBNAIL_WIDTH=400
COVER_THUMBNAIL_HEIGHT=600

# ------------------------------------------------------------
# WORKER BEHAVIOR
# ------------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3

# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
SENTRY_DSN=
SERVICE_NAME=formatting-service
SERVICE_VERSION=1.0.0