# syntax=docker/dockerfile:1.7
# ============================================================
# Formatting Service — Development Dockerfile
# Includes build tools for hot-reload of native extensions.
# ============================================================

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=4008

RUN apt-get update && apt-get install -y --no-install-recommends \
      pandoc \
      libpango-1.0-0 \
      libpangoft2-1.0-0 \
      libcairo2 \
      libgdk-pixbuf-2.0-0 \
      libjpeg62-turbo \
      zlib1g \
      libmagic1 \
      fontconfig \
      fonts-dejavu-core \
      fonts-dejavu-extra \
      fonts-liberation \
      build-essential \
      gcc \
      g++ \
      libffi-dev \
      libssl-dev \
      libcairo2-dev \
      libpango1.0-dev \
      libgdk-pixbuf-2.0-dev \
      libjpeg-dev \
      zlib1g-dev \
      libxml2-dev \
      libxslt1-dev \
      curl \
      bash \
      vim \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

CMD ["python", "-m", "app.main"]